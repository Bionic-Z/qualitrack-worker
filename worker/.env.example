# Clasificador: local (Ollama en esta maquina), gemini o keywords.
CLASSIFIER_PROVIDER=local

# Ollama corre en la misma maquina que el worker: no hay tunel de por medio.
LLM_SERVICE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3.5:9b

# Debe ser IDENTICA a la del backend. 64 caracteres hexadecimales.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WORKER_ENCRYPTION_KEY=

# Debe ser IDENTICO al del backend.
WORKER_WEBHOOK_SECRET=

# URL del Servicio A. En produccion, la de Railway.
BACKEND_URL=http://localhost:4000

# Puerto en que escucha el worker (el backend lo busca en WORKER_URL).
PORT=4001

# Solo si CLASSIFIER_PROVIDER=gemini.
GEMINI_API_KEY=
